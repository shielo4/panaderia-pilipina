# Panaderia Pilipina - configuration
#
# Copy to `.env` in the repository root (or to Project1/.env) and fill it in.
# `.env` is git-ignored and is blocked from HTTP by both router.php and
# Project1/.htaccess. On Render, set these as Environment Variables instead.

# ---------------------------------------------------------------------------
# Admin dashboard login (REQUIRED for a public deployment)
# ---------------------------------------------------------------------------
# The admin signs in with these. They must NOT be the old hardcoded demo
# password "Babyshielo" - admin access is refused if they are weak.
ADMIN_EMAIL=admin@panaderiapilipina.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Set to 1 only for local demos. Public instances should leave this at 0 so the
# known demo login (customer@gmail.com / customer123) is disabled.
ENABLE_DEMO_ACCOUNTS=0

# ---------------------------------------------------------------------------
# Password-reset email (Gmail SMTP over a raw socket)
# ---------------------------------------------------------------------------
# Requires 2-Step Verification + a 16-character Google App Password.
GMAIL_SMTP_USER=your-gmail-address@gmail.com
GMAIL_SMTP_PASS=your-16-character-app-password
GMAIL_SMTP_FROM=your-gmail-address@gmail.com
GMAIL_SMTP_FROM_NAME=Panaderia Pilipina

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Where bread_accounts.json and bread_orders.json are written. Leave empty to
# use Project1/. On Render this points at the persistent disk mount.
DATA_DIR=